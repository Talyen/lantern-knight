{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "electron/main.ts",
    "electron/preload.ts",
    "src/editor.ts",
    "src/effects-playground.ts",
    "src/main.ts",
    "src/sandbox.ts",
    "tools/diagnostics/benchmark.ts",
    "tools/build-electron.ts",
    "tools/build-identity.ts",
    "tools/check-architecture.ts",
    "tools/check-assets.ts",
    "tools/check-docs.ts",
    "tools/check-repository.ts",
    "tools/check-source-assets.ts",
    "tools/format.ts",
    "tools/diagnostics/game-benchmark.ts",
    "tools/lint.ts",
    "tools/package-bundled.cjs",
    "tools/assets/prepare/prepare-churchyard-kit.ts",
    "tools/assets/prepare/prepare-effects-playground.ts",
    "tools/assets/prepare/prepare-graveyard-art.ts",
    "tools/assets/prepare/prepare-graveyard-coverage.ts",
    "tools/assets/prepare/prepare-graveyard-ground.ts",
    "tools/assets/prepare/prepare-ground-proof.ts",
    "tools/assets/prepare/prepare-hero.ts",
    "tools/assets/prepare/prepare-ink.ts",
    "tools/assets/prepare/prepare-library.ts",
    "tools/assets/prepare/prepare-lighting.ts",
    "tools/assets/prepare/prepare-masonry.ts",
    "tools/assets/prepare/prepare-surface-relief.ts",
    "tools/assets/prepare/prepare-tended-art.ts",
    "tools/assets/prepare/prepare-visual-effects.ts",
    "tools/scene/scene-editor-store.ts",
    "tools/select-runtime-assets.ts",
    "tools/diagnostics/session-replay.ts",
    "vite.config.ts",
    "tools/assets/prepare/prepare-loading-media.ts",
    "tools/assets/prepare/prepare-flat-stage.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.ts",
    "tools/diagnostics/run-diagnostic.ts",
    "tools/ci-impact.ts",
    "tools/assets/cli.ts",
    "tools/dev.ts",
    "tools/desktop-dev.ts",
    "tools/browser-tests.ts",
    "tools/built-preview.ts",
    "tools/desktop-tests.ts",
    "tools/build.ts",
    "tools/package.ts",
    "tools/diagnostics.ts",
    "playwright.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "electron/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "tools/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "tests/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
  ],
  "include": [
    "files",
    "dependencies",
    "unlisted",
    "unresolved",
    "exports",
    "nsExports",
    "types",
    "nsTypes",
    "duplicates"
  ],
  "includeEntryExports": true,
  "ignoreDependencies": [
    "prettier",
    "electron-builder"
  ],
  "ignoreIssues": {
    "vite.config.ts": [
      "exports"
    ],
    "tools/package-bundled.cjs": [
      "exports"
    ],
    "playwright.config.ts": [
      "exports"
    ]
  },
  "ignoreExportsUsedInFile": false,
  "tags": [
    "-knip-external"
  ]
}
