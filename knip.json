{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "electron/main.ts",
    "electron/preload.ts",
    "src/editor/main.ts",
    "src/main.ts",
    "src/sandbox/main.ts",
    "tools/diagnostics/benchmark.ts",
    "tools/build-electron.ts",
    "tools/build-identity.ts",
    "tools/check-architecture.ts",
    "tools/check-assets.ts",
    "tools/check-docs.ts",
    "tools/check-repository.ts",
    "tools/format.ts",
    "tools/diagnostics/game-benchmark.ts",
    "tools/diagnostics/pacing-benchmark.ts",
    "tools/diagnostics/pacing-journey.ts",
    "tools/diagnostics/walking-benchmark.ts",
    "tools/diagnostics/startup-benchmark.ts",
    "tools/diagnostics/effect-packing.ts",
    "tools/lint.ts",
    "tools/package-bundled.cjs",
    "tools/scene/scene-editor-store.ts",
    "tools/select-runtime-assets.ts",
    "tools/diagnostics/session-replay.ts",
    "vite.config.ts",
    "tests/**/*.test.ts",
    "tests/fixtures/gpu.ts",
    "tests/fixtures/shadow-batching.ts",
    "tests/fixtures/game-effect-packing.ts",
    "tests/fixtures/painted-shadow.ts",
    "tests/**/*.spec.ts",
    "tools/diagnostics/run-diagnostic.ts",
    "tools/ci-impact.ts",
    "tools/assets/cli.ts",
    "tools/dev.ts",
    "tools/desktop-dev.ts",
    "tools/browser-tests.ts",
    "tools/built-preview.ts",
    "tools/desktop-tests.ts",
    "tools/build.ts",
    "tools/package.ts",
    "tools/diagnostics.ts",
    "tools/test-reporter.ts",
    "playwright.config.ts",
    "tools/ui-study/main.ts",
    "tools/assets/import.ts",
    "tools/assets/migrate.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "electron/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "tools/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "tests/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
  ],
  "include": [
    "files",
    "dependencies",
    "unlisted",
    "unresolved",
    "exports",
    "nsExports",
    "types",
    "nsTypes",
    "duplicates"
  ],
  "includeEntryExports": true,
  "ignoreDependencies": ["prettier", "electron-builder"],
  "ignoreIssues": {
    "vite.config.ts": ["exports"],
    "tools/package-bundled.cjs": ["exports"],
    "playwright.config.ts": ["exports"]
  },
  "ignoreExportsUsedInFile": false,
  "tags": ["-knip-external"]
}
