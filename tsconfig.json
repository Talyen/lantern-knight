{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUncheckedIndexedAccess": true, "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM"], "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["src", "electron", "tools", "tests"]
}
