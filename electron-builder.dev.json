{
  "appId": "studio.lanternknight.dev",
  "productName": "Lantern Knight Dev",
  "directories": {
    "output": "release-dev"
  },
  "files": ["dist-dev/**", "dist-electron-dev/**", "!**/*.map", "package.json"],
  "extraMetadata": {
    "main": "dist-electron-dev/main.cjs"
  },
  "asar": true,
  "electronFuses": {
    "runAsNode": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": true,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "resetAdHocDarwinSignature": true
  },
  "mac": {
    "identity": null,
    "category": "public.app-category.developer-tools"
  },
  "win": {
    "target": "dir"
  },
  "beforeBuild": "tools/package-bundled.cjs"
}
