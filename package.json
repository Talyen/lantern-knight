{
  "name": "lantern-knight",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "The connected Graveyard Approach and Ruined Chapel opening",
  "author": "Lantern Knight",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "desktop:dev": "tsx tools/desktop-dev.ts",
    "test": "tsx tools/test.ts",
    "test:watch": "tsx tools/test.ts --watch",
    "test:assets": "tsx tools/test.ts --assets",
    "test:browser": "tsx tools/browser-tests.ts",
    "test:desktop": "tsx tools/desktop-tests.ts",
    "check": "tsx tools/check.ts",
    "check:ci": "tsx tools/check.ts --ci",
    "build": "tsx tools/build.ts",
    "package": "tsx tools/package.ts",
    "assets:prepare": "tsx tools/assets/cli.ts prepare",
    "assets:inspect": "tsx tools/assets/cli.ts inspect",
    "assets:publish": "tsx tools/assets/cli.ts publish",
    "assets:clean": "tsx tools/assets/cli.ts clean",
    "assets:check": "tsx tools/assets/cli.ts check",
    "benchmark": "tsx tools/diagnostics.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsx tools/lint.ts js",
    "format": "tsx tools/format.ts",
    "format:check": "tsx tools/format.ts --check",
    "docs:check": "tsx tools/check-docs.ts",
    "repo:check": "tsx tools/check-repository.ts",
    "architecture:check": "tsx tools/check-architecture.ts",
    "knip": "tsx tools/lint.ts knip"
  },
  "dependencies": {
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "knip": "6.40.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "build": {
    "appId": "studio.lanternknight.foundation",
    "productName": "Lantern Knight",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "identity": null,
      "category": "public.app-category.role-playing-games"
    },
    "win": {
      "target": "dir"
    },
    "beforeBuild": "tools/package-bundled.cjs"
  },
  "packageManager": "npm@11.16.0"
}
